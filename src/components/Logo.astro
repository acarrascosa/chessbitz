---
// Pixel knight: "chess" + "bits". Decorative (always next to the wordmark); colours come
// from the --logo-from/--logo-to theme tokens.
import { KNIGHT_PATH } from "./knight-path";

interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 140 200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="logo-gradient" x1="0" y1="0" x2="1" y2="0.35">
            <stop offset="0" stop-color="var(--logo-from)" />
            <stop offset="1" stop-color="var(--logo-to)" />
        </linearGradient>
    </defs>
    <path fill="url(#logo-gradient)" d={KNIGHT_PATH} />
</svg>
