---
import ArchiveApp from './ArchiveApp';
import Layout from '../layouts/Layout.astro';
import { scheduledOpenings } from '../lib/catalog';
import { ui, type Lang } from '../i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} page="archive" title={t.archiveTitle} description={t.archiveMeta}>
    <ArchiveApp client:only="react" count={scheduledOpenings.length} lang={lang}>
        <Fragment slot="fallback">
            <!-- The page heading for crawlers that don't run JavaScript; the island renders its own. -->
            <h1 class="sr-only">{t.archiveTitle}</h1>
            <!-- Reserves the space until the island renders, so the footer doesn't jump. -->
            <div class="min-h-[85svh]" aria-hidden="true"></div>
        </Fragment>
    </ArchiveApp>
</Layout>
