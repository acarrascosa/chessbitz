---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Background3D from "../components/Background3D";
import ThemeToggle from "../components/ThemeToggle";
import AboutModal from "../components/AboutModal";
import Onboarding from "../components/Onboarding";
import Logo from "../components/Logo.astro";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { ui, defaultLang, homePath, legalPath, languages, type Lang } from "../i18n/ui";

interface Props {
    title?: string;
    lang?: Lang;
    /** Which page this is, to build the language alternates. */
    page?: "home" | "legal";
}

const { title, lang = defaultLang, page = "home" } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === "es" ? "en" : "es";
const pathFor = (l: Lang) => (page === "home" ? homePath(l) : legalPath(l));
const pageTitle = title ? `${title} · Chessbitz` : `Chessbitz — ${t.siteTagline}`;
const canonical = new URL(pathFor(lang), Astro.site);
const ogImage = new URL(`/og/default-${lang}.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={t.metaDescription} />
        <link rel="canonical" href={canonical} />
        {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLang), Astro.site)} />
        <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0e1815" media="(prefers-color-scheme: dark)" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Chessbitz" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={t.metaDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="generator" content={Astro.generator} />
        <script is:inline>
            // Apply the theme before first paint to avoid a flash of the wrong colours.
            try {
                const stored = localStorage.getItem("theme");
                const dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
                document.documentElement.classList.toggle("dark", dark);
            } catch {
                document.documentElement.classList.toggle("dark", window.matchMedia("(prefers-color-scheme: dark)").matches);
            }
        </script>
        <style>
            /* Zen mode hides the interface to leave only the 3D king; any click or Escape exits. */
            body.zen-mode .ui-wrapper {
                opacity: 0;
                pointer-events: none;
            }
        </style>
        <slot name="head" />
    </head>
    <body class="text-ink font-sans min-h-screen antialiased">
        <!-- The 3D king is decorative and heavy: only load it where there is room to see it. -->
        <Background3D client:media="(min-width: 1280px)" />

        <Onboarding client:idle lang={lang} />


        <script>
            const btn = document.getElementById("view-bg-btn");
            btn?.addEventListener("click", (e) => {
                e.stopPropagation();
                document.body.classList.add("zen-mode");
            });
            document.addEventListener("click", () => document.body.classList.remove("zen-mode"));
            document.addEventListener("keydown", (e) => e.key === "Escape" && document.body.classList.remove("zen-mode"));
        </script>

        <div class="ui-wrapper relative flex flex-col min-h-screen transition-opacity duration-500">
            <header class="w-full max-w-7xl mx-auto px-4 sm:px-6 pt-5 pb-2 lg:py-3 flex items-center justify-between gap-4">
                <a href={homePath(lang)} class="flex items-center gap-3 group">
                    <Logo class="h-10 w-auto transition-transform group-hover:-rotate-3" />
                    <span class="flex flex-col leading-none">
                        <span class="font-display text-2xl font-semibold tracking-tight">Chessbitz</span>
                        <span class="text-xs text-ink-muted mt-1">{t.siteTagline}</span>
                    </span>
                </a>

                <nav class="flex items-center gap-2">
                    <a
                        href={pathFor(otherLang)}
                        hreflang={otherLang}
                        lang={otherLang}
                        class="h-10 px-3 inline-flex items-center rounded-full border border-line bg-surface text-sm font-semibold hover:text-accent transition-colors"
                        title={t.switchLanguageLabel}
                    >
                        <span class="sm:hidden">{otherLang.toUpperCase()}</span>
                        <span class="hidden sm:inline">{t.switchLanguage}</span>
                    </a>
                    <button
                        id="view-bg-btn"
                        class="hidden xl:inline-flex icon-btn transition-opacity duration-500"
                        aria-label={t.zenMode}
                        title={t.zenMode}
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                    <AboutModal client:idle lang={lang} />
                    <ThemeToggle client:load lang={lang} />
                </nav>
            </header>

            <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 lg:py-2 min-h-[100svh] lg:min-h-0 lg:flex lg:flex-col lg:justify-center">
                <slot />
            </main>

            <footer class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 lg:py-3 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-ink-muted border-t border-line">
                <p>
                    {t.developedBy}
                    <a href="https://acarrascosa.com" target="_blank" rel="noopener noreferrer" class="underline decoration-line underline-offset-4 hover:text-accent">acarrascosa</a>
                </p>
                <div class="flex items-center gap-5">
                    <a href="https://github.com/acarrascosa/chessbitz" target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub</a>
                    <a href={legalPath(lang)} class="hover:text-accent">{t.legal}</a>
                    <a href="https://buymeacoffee.com/acarrascosa" target="_blank" rel="noopener noreferrer" class="btn btn-quiet px-3 py-1.5 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2"></path><path d="M14 2v2"></path><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 0 1 4 4v0a4 4 0 0 1-4 4h-1.12"></path></svg>
                        {t.buyMeCoffee}
                    </a>
                </div>
            </footer>
        </div>
    </body>
</html>
