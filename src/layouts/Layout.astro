---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Background3D from "../components/Background3D";
import HeaderActions from "../components/HeaderActions";
import Logo from "../components/Logo.astro";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { ui, defaultLang, archivePath, guidePath, homePath, legalPath, languages, type Lang } from "../i18n/ui";

type Page = "home" | "legal" | "archive" | "guide";

interface Props {
    title?: string;
    description?: string;
    lang?: Lang;
    /** Which page this is, to build the language alternates. */
    page?: Page;
}

const PATHS: Record<Page, (lang: Lang) => string> = { home: homePath, legal: legalPath, archive: archivePath, guide: guidePath };

const { title, description, lang = defaultLang, page = "home" } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === "es" ? "en" : "es";
const pathFor = (l: Lang) => PATHS[page](l);
const pageTitle = title ? `${title} · Chessbitz` : `Chessbitz — ${t.siteTagline}`;
const pageDescription = description ?? t.metaDescription;
const canonical = new URL(pathFor(lang), Astro.site);
const ogImage = new URL(`/og/default-${lang}.png`, Astro.site);
/* Game pages fit the board, panel and footer on one desktop screen (the home page centres them). */
const LAYOUT: Record<Page, string> = {
    home: "lg:py-2 lg:min-h-0 lg:flex lg:flex-col lg:justify-center",
    archive: "lg:py-2 lg:min-h-0 lg:flex lg:flex-col",
    legal: "lg:py-8",
    guide: "lg:py-8",
};
const navLink = "h-10 px-3 inline-flex items-center gap-2 rounded-full border border-line bg-surface text-sm font-semibold hover:text-accent transition-colors";
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <link rel="canonical" href={canonical} />
        {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLang), Astro.site)} />
        <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href={lang === "es" ? "/manifest.webmanifest" : "/en/manifest.webmanifest"} />
        <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0e1815" media="(prefers-color-scheme: dark)" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Chessbitz" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="generator" content={Astro.generator} />
        <script is:inline>
            // Apply the theme and contrast before first paint to avoid a flash of the wrong colours.
            (() => {
                let theme = null;
                let contrast = null;
                try {
                    theme = localStorage.getItem("theme");
                    contrast = localStorage.getItem("contrast");
                } catch {}
                const dark = theme ? theme === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
                document.documentElement.classList.toggle("dark", dark);
                document.documentElement.classList.toggle("contrast", contrast === "high");
            })();
        </script>
        <style>
            /* Zen mode hides the interface to leave only the 3D king; any click or Escape exits. */
            body.zen-mode .ui-wrapper {
                opacity: 0;
                pointer-events: none;
            }
        </style>
        <slot name="head" />
    </head>
    <body class="text-ink font-sans min-h-screen antialiased">
        <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] btn btn-primary px-4 py-2 text-sm">{t.skipToGame}</a>

        <!-- The 3D king is decorative and heavy: only load it where there is room to see it. -->
        <Background3D client:media="(min-width: 1280px)" />

        <script>
            const btn = document.getElementById("view-bg-btn");
            btn?.addEventListener("click", (e) => {
                e.stopPropagation();
                document.body.classList.add("zen-mode");
            });
            document.addEventListener("click", () => document.body.classList.remove("zen-mode"));
            document.addEventListener("keydown", (e) => e.key === "Escape" && document.body.classList.remove("zen-mode"));

            // Installable, and today's opening keeps working offline (see public/sw.js).
            if ("serviceWorker" in navigator && import.meta.env.PROD) {
                window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
            }
        </script>

        <div class="ui-wrapper relative flex flex-col min-h-screen transition-opacity duration-500">
            <header class="w-full max-w-7xl mx-auto px-4 sm:px-6 pt-5 pb-2 lg:py-3 flex items-center justify-between gap-2 sm:gap-4">
                <a href={homePath(lang)} class="flex items-center gap-2.5 sm:gap-3 group min-w-0">
                    <Logo class="h-9 sm:h-10 w-auto shrink-0 transition-transform group-hover:-rotate-3" />
                    <span class="flex flex-col leading-none min-w-0">
                        <span class="font-display text-xl sm:text-2xl font-semibold tracking-tight">Chessbitz</span>
                        <span class="hidden min-[400px]:block text-xs text-ink-muted mt-1 truncate">{t.siteTagline}</span>
                    </span>
                </a>

                <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Chessbitz">
                    <a href={archivePath(lang)} class={navLink} aria-current={page === "archive" ? "page" : undefined}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>
                        <span class="hidden md:inline">{t.navArchive}</span>
                        <span class="sr-only md:hidden">{t.navArchive}</span>
                    </a>
                    <a href={pathFor(otherLang)} hreflang={otherLang} lang={otherLang} class={`${navLink} hidden sm:inline-flex`} title={t.switchLanguageLabel}>
                        {t.switchLanguage}
                    </a>
                    <button id="view-bg-btn" class="hidden xl:inline-flex icon-btn transition-opacity duration-500" aria-label={t.zenMode} title={t.zenMode}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                    <div class="flex items-center gap-1.5 sm:gap-2 min-w-[8.25rem] sm:min-w-[8.5rem] justify-end">
                        <HeaderActions client:load lang={lang} alternateHref={pathFor(otherLang)} />
                    </div>
                </nav>
            </header>

            <main id="main" tabindex="-1" class={`flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 min-h-[100svh] outline-none ${LAYOUT[page]}`}>
                <slot />
            </main>

            <footer class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 lg:py-3 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-ink-muted border-t border-line">
                <p>
                    {t.developedBy}
                    <a href="https://acarrascosa.com" target="_blank" rel="noopener noreferrer" class="underline decoration-line underline-offset-4 hover:text-accent">acarrascosa</a>
                </p>
                <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
                    <a href={guidePath(lang)} class="hover:text-accent">{t.guideTitle}</a>
                    <a href={pathFor(otherLang)} hreflang={otherLang} lang={otherLang} class="hover:text-accent sm:hidden">{t.switchLanguage}</a>
                    <a href="https://github.com/acarrascosa/chessbitz" target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub</a>
                    <a href={legalPath(lang)} class="hover:text-accent">{t.legal}</a>
                    <a href="https://buymeacoffee.com/acarrascosa" target="_blank" rel="noopener noreferrer" class="btn btn-quiet px-3 py-1.5 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2"></path><path d="M14 2v2"></path><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 0 1 4 4v0a4 4 0 0 1-4 4h-1.12"></path></svg>
                        {t.buyMeCoffee}
                    </a>
                </div>
            </footer>
        </div>
    </body>
</html>
