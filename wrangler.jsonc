{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessbitz",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Astro builds the static site; the Worker only handles /api/* and the
  // home pages (to inject today's link preview). Everything else is served
  // straight from the asset store.
  "build": { "command": "npm run build", "watch_dir": "worker" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/en/", "/en"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chessbitz",
      // Run `npx wrangler d1 create chessbitz` and paste the id here (see DEPLOY.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RESULTS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "chessbitz.com", "custom_domain": true },
    { "pattern": "www.chessbitz.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
